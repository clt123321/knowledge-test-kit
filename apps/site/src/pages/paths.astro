---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getModulesResolved } from '../lib/content';
const modules = await getModulesResolved();
---
<BaseLayout title="学习路径">
  <h1>学习路径</h1>
  <p>推荐按下述顺序学习：</p>
  <ol>
    {modules.map((m) => (
      <li>
        <strong>{m.name}</strong>
        {m.description && <div style="color:var(--kt-color-muted)">{m.description}</div>}
      </li>
    ))}
  </ol>
</BaseLayout>
