---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBank, siteBase } from '../../lib/content';
import { renderMathMarkdown } from '../../lib/render';
import { promises as fs } from 'node:fs';
import path from 'node:path';
import fg from 'fast-glob';

const bank = await getBank();
const base = siteBase();

interface RefEntry {
  id: string;
  title: string;
  type?: string;
  authors?: string[];
  year?: number;
  url?: string;
  tier?: string;
  summary?: string;
}

async function loadRefs(): Promise<RefEntry[]> {
  const files = await fg(bank.config.content.referenceGlobs, { cwd: bank.contentDir, onlyFiles: true });
  const out: RefEntry[] = [];
  for (const rel of files) {
    const abs = path.join(bank.contentDir, rel);
    if (rel.endsWith('.json')) {
      try {
        const raw = JSON.parse(await fs.readFile(abs, 'utf8'));
        if (Array.isArray(raw)) out.push(...(raw as RefEntry[]));
        else if (raw && typeof raw === 'object') out.push(raw as RefEntry);
      } catch {
        /* skip */
      }
    }
  }
  return out;
}

async function loadSyllabus() {
  const files = await fg(bank.config.content.syllabusGlobs, { cwd: bank.contentDir, onlyFiles: true });
  const preferred =
    files.find((rel) => /syllabus|考纲/i.test(path.basename(rel))) ??
    files.find((rel) => rel.endsWith('.md')) ??
    null;
  if (!preferred) return null;
  const raw = await fs.readFile(path.join(bank.contentDir, preferred), 'utf8');
  return {
    relativePath: preferred,
    html: renderMathMarkdown(raw),
  };
}

const refs = await loadRefs();
const syllabus = await loadSyllabus();
const books = refs.filter((r) => r.type === 'book');
const papers = refs.filter((r) => r.type === 'paper');
const docs = refs.filter((r) => r.type === 'official_docs');
const notes = refs.filter((r) => !['book', 'paper', 'official_docs'].includes(r.type ?? 'other'));
---

<BaseLayout title="考纲">
  <h1>考纲</h1>
  <p style="color:var(--kt-color-muted)">
    这里优先展示这套题库的知识地图与维护参考。共 {refs.length} 条参考项
    · <a href={base + 'references/books/'}>书籍</a>
    · <a href={base + 'references/papers/'}>论文</a>
    · <a href={base + 'references/docs/'}>官方文档</a>
  </p>

  {syllabus && (
    <section class="kt-card">
      <h2>考纲</h2>
      <p style="color:var(--kt-color-muted)">来自 <code>{syllabus.relativePath}</code>，用于展示这套题库覆盖的知识地图。</p>
      <div class="kt-syllabus" set:html={syllabus.html} />
    </section>
  )}

  {[['书籍', books, 'books'], ['论文', papers, 'papers'], ['官方文档', docs, 'docs'], ['前沿笔记 / 其他', notes, 'notes']].map(([title, items, slug]) => {
    const arr = items as RefEntry[];
    return arr.length > 0 && (
      <section class="kt-card">
        <h2>{title as string} ({arr.length})</h2>
        <ul>
          {arr.map((r) => (
            <li style="margin-bottom:6px">
              {r.url ? <a href={r.url} target="_blank" rel="noreferrer">{r.title}</a> : r.title}
              {r.year && <span style="color:var(--kt-color-muted)"> ({r.year})</span>}
              {r.tier && <span class="kt-tag" style="margin-left:8px">{r.tier}</span>}
              {r.summary && <div style="color:var(--kt-color-muted); font-size:14px">{r.summary}</div>}
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</BaseLayout>
