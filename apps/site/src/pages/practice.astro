---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVisibleQuestions, getModulesResolved, getSummary } from '../lib/content';
import PracticeIsland from '../islands/PracticeIsland';

const questions = await getVisibleQuestions();
const modules = await getModulesResolved();
const summary = await getSummary();

// Ship only the fields the practice engine needs, to keep the JS payload lean.
const clientQuestions = questions.map((q) => ({
  id: q.id,
  type: q.type,
  module: q.module,
  difficulty: q.difficulty,
  subtopic: q.subtopic,
  stem: q.stem,
  options: q.options,
  correctAnswers: q.correctAnswers,
  explanation: q.explanation,
  optionExplanations: q.optionExplanations,
}));

const bankId = import.meta.env.KT_BANK_ID || summary.bankId;
---

<BaseLayout title="本地考试">
  <div class="kt-title-row">
    <h1 style="margin:0">本地考试</h1>
    <span class="kt-help" tabindex="0" aria-label="查看本地考试说明">
      ?
      <span class="kt-help-popover">
        这里支持综合考试、按模块考试、随机抽题、错题复盘和对题复盘。你的答题记录会保存在当前浏览器里，
        刷新本地服务后依然可继续查看和复盘。<br /><br />
        不需要账号，也不会把数据上传到服务器。<code>本地存储标识：knowledge-test:{bankId}:*</code>
      </span>
    </span>
  </div>

  <PracticeIsland
    client:only="react"
    questions={clientQuestions}
    modules={modules}
    bankId={bankId}
    defaultConfig={{
      singleScore: 2,
      multipleScore: 3,
      passRatio: 0.6,
      singleCount: 6,
      multipleCount: 3,
      shuffleQuestions: true,
      shuffleOptions: true,
    }}
  />
</BaseLayout>
