{
  "name": "knowledge-test-kit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-agnostic knowledge test kit — static site generator, local practice engine, and content-authoring skill.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clt123321/knowledge-test-kit.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "cli": "node packages/cli/bin/knowledge-test.mjs",
    "dev": "node packages/cli/bin/knowledge-test.mjs dev --content examples/demo-bank",
    "build": "node packages/cli/bin/knowledge-test.mjs build --content examples/demo-bank",
    "validate": "node packages/cli/bin/knowledge-test.mjs validate --content examples/demo-bank",
    "validate:demo": "node packages/cli/bin/knowledge-test.mjs validate --content examples/demo-bank",
    "build:demo": "node packages/cli/bin/knowledge-test.mjs build --content examples/demo-bank",
    "doctor:demo": "node packages/cli/bin/knowledge-test.mjs doctor --content examples/demo-bank",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rm -rf apps/site/dist apps/site/.astro packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
